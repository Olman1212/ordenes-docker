# Copie este archivo como .env y cambie los valores:
#   Windows (PowerShell):  Copy-Item .env.example .env
#   Linux / macOS:         cp .env.example .env
#
# La contraseña de SA debe tener 8 caracteres o más y combinar
# mayúsculas, minúsculas, números y símbolos (requisito de SQL Server).
MSSQL_SA_PASSWORD=Cambie_Esta_Clave_123

# Clave secreta de Django (cualquier texto largo y aleatorio).
DJANGO_SECRET_KEY=cambie-esta-clave-secreta-de-django

# Usuario de Docker Hub con el que se etiquetan las imágenes api y web.
DOCKERHUB_USER=olman1212
